# ==============================================================================
# MuRegistry Artifact & Package Registry Configuration Environment
# Path: /etc/mu-registry/registry.env (Permissions: 0600 mu-registry:mu-registry)
# ==============================================================================

# Content-Addressed Storage (CAS) and DuckDB catalog root directory
MU_REGISTRY_ROOT_DIR=/var/lib/mu-registry

# Public/cluster base URL advertised in Cargo sparse index config.json
MU_REGISTRY_BASE_URL=https://registry.cluster.internal:8444

# TCP bind address for the registry HTTP/mTLS listener
MU_REGISTRY_LISTEN_ADDR=0.0.0.0:8444

# Logical node identifier emitted on OpenTelemetry spans and audit logs
MU_REGISTRY_NODE_ID=node-a

# step-ca mutual TLS certificate bundle paths
MU_REGISTRY_TLS_CA=/etc/mu-registry/tls/ca.crt
MU_REGISTRY_TLS_CERT=/etc/mu-registry/tls/server.crt
MU_REGISTRY_TLS_KEY=/etc/mu-registry/tls/server.key

# Fail closed if TLS certificates are absent (set to false for plain TCP local dev)
MU_REGISTRY_REQUIRE_TLS=true

# Trust reverse-proxy x-client-cert-san header fallback (disabled by default)
MU_REGISTRY_TRUST_PROXY_SAN_HEADER=false

# Optional MuObservable collector address for MUOB Arrow telemetry forwarding
# MU_OBSERVABLE_COLLECTOR_ADDR=127.0.0.1:4319

# Tracing and logging level
RUST_LOG=info,mu_registry=debug
